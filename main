<div class="container">
    <header>
        <h1>DASHBOARD DE DESPACHOS</h1>
        <div>
            <button class="btn" id="load-btn" onclick="enlazarArchivo()">Enlazar Planilla Local</button>
            <button class="btn" id="sync-btn" onclick="procesarArchivo()">Sincronizar Cambios</button>
        </div>
    </header>

    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-title">Total Órdenes</div>
            <div class="kpi-value" id="kpi-total">0</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-title">Entregados</div>
            <div class="kpi-value" id="kpi-entregados" style="color: #34d399;">0</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-title">Pendientes</div>
            <div class="kpi-value" id="kpi-pendientes" style="color: #fbbf24;">0</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-title">Con Observaciones</div>
            <div class="kpi-value" id="kpi-problemas" style="color: #f87171;">0</div>
        </div>
    </div>

    <div class="dashboard-content">
        <div class="panel">
            <canvas id="statusChart"></canvas>
        </div>
        <div class="panel" style="overflow-y: auto; max-height: 400px;">
            <table>
                <thead>
                    <tr>
                        <th>N° Venta</th>
                        <th>Cliente</th>
                        <th>Estado</th>
                        <th>Motivo / Detalle</th>
                    </tr>
                </thead>
                <tbody id="table-body">
                    <tr><td colspan="4" style="text-align:center; color:#555;">Enlaza tu planilla para visualizar datos.</td></tr>
                </tbody>
            </table>
        </div>
    </div>
