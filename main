<script>
    let fileHandle;
    let chartInstance = null;

    async function enlazarArchivo() {
        try {
            [fileHandle] = await window.showOpenFilePicker({
                types: [{ description: 'Archivos Excel', accept: {'application/vnd.ms-excel': ['.xls', '.xlsx']} }]
            });
            document.getElementById('load-btn').style.display = 'none';
            document.getElementById('sync-btn').style.display = 'inline-block';
            await procesarArchivo();
        } catch (error) {
            console.log("Selección cancelada o API no soportada.", error);
        }
    }

    async function procesarArchivo() {
        if (!fileHandle) return;
        const file = await fileHandle.getFile();
        const data = await file.arrayBuffer();
        const workbook = XLSX.read(data, {type: 'array'});
        const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
        const jsonData = XLSX.utils.sheet_to_json(firstSheet);
        actualizarDashboard(jsonData);
    }

    function actualizarDashboard(data) {
        let entregados = 0, pendientes = 0, problemas = 0;
        const tbody = document.getElementById('table-body');
        tbody.innerHTML = '';

        data.forEach(row => {
            const estadoBase = row['Estado'] || 'Desconocido';
            const estaEntregado = row['Entregado'] === 'Sí' || estadoBase === 'Concluida';
            const motivo = row['Motivo'] || (estadoBase === 'Nula' ? 'Anulado' : '-');
            
            let statusClass = 'pendiente';
            let statusText = 'Pendiente';

            if (estaEntregado) {
                entregados++;
                statusClass = 'entregado';
                statusText = 'Entregado';
            } else if (estadoBase === 'Nula' || row['Entregado'] === 'No') {
                problemas++;
                statusClass = 'problema';
                statusText = 'Observación';
            } else {
                pendientes++;
            }

            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>${row['N.Venta'] || '#'}</td>
                <td>${row['Nombre Cliente'] || 'Sin Nombre'}</td>
                <td><span class="badge ${statusClass}">${statusText}</span></td>
                <td style="color:#aaa;">${motivo}</td>
            `;
            tbody.appendChild(tr);
        });

        document.getElementById('kpi-total').innerText = data.length;
        document.getElementById('kpi-entregados').innerText = entregados;
        document.getElementById('kpi-pendientes').innerText = pendientes;
        document.getElementById('kpi-problemas').innerText = problemas;

        renderizarGrafico(entregados, pendientes, problemas);
    }

    function renderizarGrafico(entregados, pendientes, problemas) {
        const ctx = document.getElementById('statusChart').getContext('2d');
        if (chartInstance) chartInstance.destroy();
        
        Chart.defaults.color = '#888';
        chartInstance = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Entregados', 'Pendientes', 'Con Observaciones'],
                datasets: [{
                    data: [entregados, pendientes, problemas],
                    backgroundColor: ['#064e3b', '#78350f', '#7f1d1d'],
                    borderColor: '#1a1a1a',
                    borderWidth: 2
                }]
            },
            options: { responsive: true, cutout: '75%', plugins: { legend: { position: 'bottom' } } }
        });
    }
</script>
</body>
